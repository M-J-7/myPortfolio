# Contact form — EmailJS (https://dashboard.emailjs.com)
#
# Copy this file to `.env` and fill in the three values from your dashboard.
# Without them the form stays visible but tells visitors to use LinkedIn
# instead of failing silently.
#
# NOTE: the old hardcoded service id was "service_mysaku@7", which is not a
# valid EmailJS service id — that is almost certainly why the previous form
# never delivered anything. Copy the real id from Email Services.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=template_mchkqci
VITE_EMAILJS_PUBLIC_KEY=j3pnPpoWPqqcGx1EE
